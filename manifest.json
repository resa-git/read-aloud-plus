{
  "manifest_version": 3,
  "name": "Read Aloud Plus",
  "version": "0.1.0",
  "description": "Read any page aloud with Azure, local Kokoro or Edge voices. Click a word to start there; sentence and word highlighting.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.tts.speech.microsoft.com/*", "http://localhost:8880/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Read Aloud Plus" },
  "commands": {
    "toggle-mode": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Toggle click-to-read mode"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/platform.js",
        "src/text.js",
        "src/player.js",
        "src/engine-azure.js",
        "src/engine-local.js",
        "src/engine-edge.js",
        "src/reader.js"
      ],
      "css": ["src/reader.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
